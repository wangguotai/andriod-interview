<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 图片加载 Lab：picsum 网络图源 + okhttp 下载原图 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络质量感知：读取当前网络类型与计费属性（ConnectivityManager） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".application.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="33">

        <!-- ═══════════════════════════════════════════
             首页 —— 工程唯一 LAUNCHER
             底部 duotab（实验台 / 基础），集中登记全部功能页。
             新增功能页：改 HomeCatalog 即可，勿再往各 Lab 挂 LAUNCHER。
             ═══════════════════════════════════════════ -->
        <activity
            android:name="com.interview.home.HomeActivity"
            android:exported="true"
            android:label="面试实验室"
            android:theme="@style/Theme.MyApplication.AppCompat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.wgt.recyclerview.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication.AppCompat">
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->

<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->
        </activity>
        <activity
            android:name="com.wgt.draw_text.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication.AppCompat">
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->

<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->
        </activity>
        <activity
            android:name=".activity.Main2Activity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication.AppCompat">

            <!-- <intent-filter> -->
            <!-- <action android:name="android.intent.action.MAIN" /> -->


            <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
            <!-- </intent-filter> -->
        </activity>
        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication" />

        <activity android:name="com.interview.liveData.ui.LiveDataDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication">
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->

<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->
        </activity>

        <activity
            android:name="com.interview.leak.HandlerLeakActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication.AppCompat">
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->

<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->
        </activity>

        <activity
            android:name="com.interview.thread.ThreadGovernanceActivity"
            android:exported="true"
            android:label="线程治理 Demo"
            android:theme="@style/Theme.MyApplication.AppCompat">
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->

<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->
        </activity>

        <!-- ═══════════════════════════════════════════
             图片加载 Lab —— Glide 降采样教学
             ═══════════════════════════════════════════ -->

        <!-- 主入口：瀑布流大图加载 + 内存水位证据面板。
             入口统一走首页（HomeCatalog 登记），此处不再挂 LAUNCHER，
             避免出现第二个图标、也避免「谁改 Manifest 谁就是入口」的老问题。 -->
        <activity
            android:name="com.interview.image.ImageLabActivity"
            android:exported="true"
            android:label="大图加载 Lab"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- 解剖台：inSampleSize 推导过程逐步展开（裸 BitmapFactory） -->
        <activity
            android:name="com.interview.image.DecodeInspectorActivity"
            android:exported="true"
            android:label="降采样解剖台"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- 三态对照：normal / wrap_content / override -->
        <activity
            android:name="com.interview.image.DecodeComparisonActivity"
            android:exported="true"
            android:label="三态对照实验"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- ═══════════════════════════════════════════
             网络层优化 Lab —— OkHttp 感知/度量/DNS/重试
             ═══════════════════════════════════════════ -->
        <activity
            android:name="com.interview.net.NetLabActivity"
            android:exported="true"
            android:label="网络优化 Lab"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- 网络度量仪表盘：把感知/度量图形化（阶段堆叠/分位时序/切网事件/弱网模拟器）。
             与 NetLabActivity 互补：那个看证据细节，这个看整体形状。 -->
        <activity
            android:name="com.interview.net.NetDashboardActivity"
            android:exported="true"
            android:label="网络度量仪表盘"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- ═══════════════════════════════════════════
             稳定性监控 Lab —— ANR / Crash / 卡顿 线上监控
             三类数据各一条采集链路 + 一个统一上报出口
             ═══════════════════════════════════════════ -->
        <activity
            android:name="com.interview.稳定性监控.StabilityLabActivity"
            android:exported="true"
            android:label="稳定性监控 Lab"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- ═══════════════════════════════════════════
             VMP 加固 Lab —— 加密字节码虚拟机 + 逐位对拍 + 基准
             实现来自 :vmp-core（library）；Activity 声明必须留在宿主
             Manifest —— library 里声明会让每个宿主 inherits 这个页面。
             ⚠️ 名字必须写**全限定名**：:vmp-core 的 namespace 是
             com.interview.vmp，而本 app 的 namespace 是 com.example.myapplication，
             写 `.ui.VmpLabActivity` 会被解析成 com.example.myapplication.ui.*（不存在）。
             ═══════════════════════════════════════════ -->
        <activity
            android:name="com.interview.vmp.ui.VmpLabActivity"
            android:exported="false"
            android:label="VMP 加固 Lab"
            android:theme="@style/Theme.MyApplication.AppCompat" />
    </application>

</manifest>