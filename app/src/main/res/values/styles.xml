<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 声明一个CustomViewGroup默认style   -->
    <style name="CustomViewGroupStyle">
        <item name="android:textColor">#ff0000</item>
        <item name="android:textSize">20sp</item>
        <item name="layout_simple_attr_1">2</item>
        <item name="android:background">#FF5722</item>
    </style>

    <!-- 网络仪表盘的分区小标题：统一「上间距 + 加粗 + 灰蓝」，
         避免每个 TextView 各写一遍 layout_marginTop/textStyle 而漂移。 -->
    <style name="DashSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1C3D5A</item>
    </style>
</resources>