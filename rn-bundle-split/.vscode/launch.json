{
  // ═══════════════════════════════════════════════════════════════════════════
  // 调试 prepare-android-demo.sh 的三步。
  //
  // ⚠️ 先读这段，否则会"断点打不上"却找不到原因：
  //
  //   scripts/prepare-android-demo.sh 只有 60 行，每一行都只是
  //   `node packages/rn-bundle-split/bin/rn-bundle-split.js <cmd> ...` 的包装。
  //   真正的拆包逻辑（2500+ 行）全在 JS 里。所以：
  //
  //     · 想单步 .sh 本体       → 需要 bashdb + rogalmic.bash-debug 扩展（本机没装）
  //     · 想断在"真正干活"的代码 → 用下面这几个配置，零安装，VS Code 自带 Node 调试器
  //
  //   这就是下面给 JS 而没给 shell 的原因。
  //
  // ═══════════════════════════════════════════════════════════════════════════
  //
  // 断点该打在哪（这三处就是脚本三步各自的实质逻辑）：
  //
  //   ① lib/build.js  : runBaseBuild()       — base 包的 module id 计算、mapping 落盘
  //   ② lib/split.js  : runBusinessBuild()   — 按 mapping 剥离 base 内容
  //   ③ lib/verify.js : runVerify()          — L1/L2/L3 三级校验
  //
  //   想追更底层：moduleIdFactory.js（id 哈希）、strip.js（裁剪）、metro.js（构建）
  //
  // ⚠️ 子进程边界：build.js / split.js 用 spawnSync 调 hermesc（仅 --hermes 时走到）。
  //    spawnSync 阻塞 JS 线程，**子进程内部调不进去**，但 fork 前后的断点照常命中。
  //    默认（不加 --hermes）完全不碰这条路径。
  //
  // ⚠️ 为什么没有"一把跑完三步"的调试配置：CLI 一次进程只执行一个子命令，
  //    而 VS Code 的 compound 是**并行**启动（split 依赖 base 的 mapping 产物，必须串行）。
  //    想一把跑完且要断点：按 ①→②→③ 顺序各起一次调试即可。
  //    想一把跑完不要断点：直接跑 `bash scripts/prepare-android-demo.sh`。
  // ═══════════════════════════════════════════════════════════════════════════

  "version": "0.2.0",
  "configurations": [
    {
      // ── 脚本第 1 步：产出 base bundle + mapping ──────────────────────────────
      // 等价于 scripts/prepare-android-demo.sh:27
      //   node "$CLI" base --project "$ROOT/host-app" --out "$BASE_OUT"
      // 断点建议：lib/build.js 的 runBaseBuild()、lib/moduleIdFactory.js
      "name": "① base bundle（脚本第 1/3 步）",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/packages/rn-bundle-split/bin/rn-bundle-split.js",
      "args": [
        "base",
        "--project",
        "${workspaceFolder}/host-app",
        "--out",
        "${workspaceFolder}/host-app/output"
      ],
      // 不跳进 metro 内部（否则单步会掉进几千行构建器代码里）；
      // 本工具自己的 lib/*.js 不在 node_modules 下，断点照常命中
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      // ── 脚本第 2 步：按 mapping 剥离出业务包 ────────────────────────────────
      // 等价于 scripts/prepare-android-demo.sh:31
      //   node "$CLI" split --project business-app --mapping "$MAPPING" --out "$BIZ_OUT"
      // 断点建议：lib/split.js 的 runBusinessBuild()、lib/strip.js
      //
      // ⚠️ 依赖第 1 步的产物：host-app/output/base.android.release.mapping.json
      //    没跑过第 1 步会直接报「找不到 mapping」——这不是配置坏了。
      "name": "② 业务 bundle（脚本第 2/3 步）",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/packages/rn-bundle-split/bin/rn-bundle-split.js",
      "args": [
        "split",
        "--project",
        "${workspaceFolder}/business-app",
        "--mapping",
        "${workspaceFolder}/host-app/output/base.android.release.mapping.json",
        "--out",
        "${workspaceFolder}/business-app/output"
      ],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      // ── 脚本第 3 步：三级校验 ──────────────────────────────────────────────
      // 等价于 scripts/prepare-android-demo.sh:38
      //   node "$CLI" verify --project business-app --mapping "$MAPPING" \
      //        --business "$BIZ_BUNDLE" --base "$BASE_BUNDLE"
      // 断点建议：lib/verify.js 的 runVerify() / verifyStatic() / verifyRuntime()
      //
      // ⚠️ 依赖第 1、2 步的产物（base bundle、业务 bundle）
      "name": "③ 校验业务包（脚本第 3/3 步）",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/packages/rn-bundle-split/bin/rn-bundle-split.js",
      "args": [
        "verify",
        "--project",
        "${workspaceFolder}/business-app",
        "--mapping",
        "${workspaceFolder}/host-app/output/base.android.release.mapping.json",
        "--business",
        "${workspaceFolder}/business-app/output/business.android.release.bundle",
        "--base",
        "${workspaceFolder}/host-app/output/base.android.release.bundle"
      ],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      // ── 只看一个 bundle 的结构（诊断用，不是脚本的一步）─────────────────────
      // CLI 的只读命令：不写任何文件，打印运行时前缀 / __d 定义 / module id / 尾部语句。
      // 排查「业务包怎么还有 base 内容」时比断点更快。默认看业务包，想换文件改 args[1]。
      "name": "🔍 inspect 业务包结构",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/packages/rn-bundle-split/bin/rn-bundle-split.js",
      "args": [
        "inspect",
        "${workspaceFolder}/business-app/output/business.android.release.bundle",
        "${workspaceFolder}/business-app"
      ],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      // ── 附加到已在跑的 node（进阶）─────────────────────────────────────────
      // 用途：想调跨进程场景，或自己已经起了带调试端口的进程。
      // 用法：先 `node --inspect-brk packages/rn-bundle-split/bin/rn-bundle-split.js base ...`
      //       再启动本配置。
      "name": "⏸ 附加到已启动的 node（--inspect-brk）",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
