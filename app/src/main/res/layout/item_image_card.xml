<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <!-- ══════════════ Rust 主色调占位色 ══════════════
         铺在 ImageView 之下，由 WaterfallAdapter 用 PlaceholderPalette 的结果填色。
         为什么独立成一个 View 而不是直接给 ImageView 设 background/tint：
         tint 会参与图片绘制、改变真实颜色；占位色的语义是「图未到，先垫一层」，
         图片一画上来必须完全遮住它。独立垫底是唯一不会产生意外的做法。
         尺寸与 ImageView 一致（match_parent × 240dp），避免露出边缘。 -->
    <View
        android:id="@+id/v_palette"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#E8E8E8"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- 徽标：直接把「解码出来的真实尺寸 / 真实内存 / 采样倍数」压在图上报出来。
         这是本 demo 的证据核心 —— 学生不必信我们说的，他看的是 Bitmap 自己的数。 -->
    <TextView
        android:id="@+id/tv_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:background="#C0000000"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFF"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tv_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_margin="4dp"
        android:background="#C0B00020"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:text="下载原图中…"
        android:textColor="#FFFFFF"
        android:textSize="10sp" />

</FrameLayout>
