    <string name="plugin_layout_line1">layout 来自插件（不是宿主）</string>
    <string name="plugin_layout_line2">背景色 / 文字色 / 字号也都是插件 res/values 里的</string>
    <string name="plugin_activity_label">插件 Activity（由宿主占坑反射拉起）</string>

    <!-- root 级文件：不进 resources.arsc，验证的是 AssetManager 的 addAssetPath
         能把「包根目录」也一起挂上（很多插件框架漏掉这一层）。 -->
    <string name="plugin_root_probe_name">plugin-root-probe.txt</string>
