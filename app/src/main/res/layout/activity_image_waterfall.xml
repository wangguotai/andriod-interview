<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ══════════════ 证据面板：内存水位 ══════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101820"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_mem_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="内存水位"
            android:textColor="#7CF5C0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_graphics"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_mem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="#D8E4EC"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_ledger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textColor="#FFD479"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ══════════════ 本次实验的配置 ══════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="itv_item 徽标：解码尺寸 · 解码内存 · ÷采样倍数"
            android:textSize="11sp" />

        <Switch
            android:id="@+id/sw_raw_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="对照组：.override(SIZE_ORIGINAL) 强解析原尺寸（危险）"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/sw_auto_load"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="滚动到底自动加载下一页（关掉后只能用底部按钮手动翻页）"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_open_inspector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="解剖台：看 inSampleSize 怎么算" />

            <Button
                android:id="@+id/btn_open_compare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="三态对照实验" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════ 瀑布流 ══════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_images"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btn_next_page"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="加载下一页" />

        <Button
            android:id="@+id/btn_clear_cache"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="清磁盘缓存" />

        <Button
            android:id="@+id/btn_reset_ledger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="重置账本" />
    </LinearLayout>

</LinearLayout>
